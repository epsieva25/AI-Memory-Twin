# PostgreSQL
POSTGRES_USER=memorytwin
POSTGRES_PASSWORD=memorytwin_pass
POSTGRES_DB=memorytwin_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://memorytwin:memorytwin_pass@postgres:5432/memorytwin_db

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=memorytwin_neo4j

# Ollama (use http://ollama:11434 in Docker, http://localhost:11434 for local Ollama)
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3
OLLAMA_REQUEST_TIMEOUT=180
OLLAMA_HEALTH_TIMEOUT=90
OLLAMA_NUM_PREDICT=256
OLLAMA_MAX_RETRIES=3

# App
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173